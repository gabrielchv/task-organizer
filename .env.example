# ---------- Server-only (never exposed to the browser) ----------

# Gemini API key. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Firebase service account for the Admin SDK, as a single-line JSON string.
# Leave empty when running against the emulators (Application Default Credentials
# are used instead, together with FIRESTORE_EMULATOR_HOST).
FIREBASE_SERVICE_ACCOUNT=

# Optional. Enables the `web_search` tool. Without it the tool is not registered
# and the assistant tells the user that web search is unavailable.
# https://brave.com/search/api/
SEARCH_API_KEY=

# Optional. debug | info | warn | error. Defaults to "info".
LOG_LEVEL=info

# ---------- Public (inlined into the client bundle) ----------
# These are public identifiers, not secrets: Firebase web config is designed to
# ship to the browser. Access control lives in firestore.rules, not here.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Public bucket serving the Vosk speech models.
NEXT_PUBLIC_VOSK_BUCKET_URL=https://storage.googleapis.com/task-organizer-assets
